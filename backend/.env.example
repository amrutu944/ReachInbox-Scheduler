# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# Redis (BullMQ + rate limit counters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails

# Ethereal Email (SMTP) - generate at https://ethereal.email
# You can define MULTIPLE senders as a JSON array (round-robin senders)
# Each sender needs its own Ethereal test account (host is always smtp.ethereal.email)
ETHEREAL_SENDERS=[{"name":"sender-one","user":"REPLACE_ME@ethereal.email","pass":"REPLACE_ME"},{"name":"sender-two","user":"REPLACE_ME2@ethereal.email","pass":"REPLACE_ME2"}]

# Worker / scheduling behavior
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Google OAuth (real login) - create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# JWT secret used for our own session cookie/token after verifying Google ID token
JWT_SECRET=change-this-to-a-long-random-string

# Slack OAuth (real "Connect Slack" flow) - create app at https://api.slack.com/apps
SLACK_CLIENT_ID=REPLACE_ME
SLACK_CLIENT_SECRET=REPLACE_ME
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
